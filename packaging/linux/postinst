#!/bin/sh
# Paquet Debian tlsrelay : compte système, répertoire de configuration ; après
# une mise à jour, instances en service relancées avec le nouveau binaire.
set -e
if [ "$1" = configure ]; then
    getent group tlsrelay >/dev/null || groupadd --system tlsrelay
    getent passwd tlsrelay >/dev/null ||
        useradd --system --gid tlsrelay --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin tlsrelay
    [ -d /etc/tlsrelay ] || install -d -m 0750 -o root -g tlsrelay /etc/tlsrelay
    if [ -n "$2" ] && [ -d /run/systemd/system ]; then
        systemctl try-restart 'tlsrelay@*.service' >/dev/null 2>&1 || true
    fi
fi
exit 0
