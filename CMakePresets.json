{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux Debug + AddressSanitizer/UBSan",
      "inherits": "linux-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "TLSRELAY_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "linux-fuzz",
      "displayName": "Linux fuzzing libFuzzer (clang, ASan/UBSan)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "TLSRELAY_SANITIZERS": "address,undefined,fuzzer-no-link",
        "TLSRELAY_FUZZ": "ON",
        "TLSRELAY_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 (MSVC + vcpkg)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-fuzz", "configurePreset": "linux-fuzz" },
    { "name": "windows-release", "configurePreset": "windows-msvc", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } },
    { "name": "linux-asan", "configurePreset": "linux-asan", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-msvc", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
