# Static analysis (PLAN §5): likely defects, security, concurrency,
# clang path analyzer. The selected rules are blocking in CI.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-unchecked-optional-access,
  cert-*,
  -cert-err58-cpp,
  clang-analyzer-*,
  -clang-analyzer-optin.cplusplus.VirtualCall,
  concurrency-*,
  -concurrency-mt-unsafe,
  performance-*,
  -performance-enum-size,
  misc-redundant-expression,
  misc-unused-using-decls
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/src/core/(include|src)/.*'
