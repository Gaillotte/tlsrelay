# ThreadSanitizer suppressions ("Linux Clang TSan" job).
# Qt is not built with ThreadSanitizer: its internal threads (file dialog
# thread pool, icon loading) reuse memory blocks that TSan, not seeing their
# synchronization, reports as races.
# The project's own code remains fully checked.
race:libQt6Core.so
race:libQt6Gui.so
race:libQt6Widgets.so
